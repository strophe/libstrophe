<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.w3.org/2000/01/rdf-schema#"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns="http://usefulinc.com/ns/doap#"
  xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
  xmlns:schema="https://schema.org/">
  <Project>
    <name>libstrophe</name>

    <!-- First commit in Github. Ralph “rillian” Giles knows more. -->
    <created>2005-06-14</created>

    <shortdesc xml:lang="en">C library for XMPP clients</shortdesc>
    <shortdesc xml:lang="fr">Bibliothèque C pour les clients XMPP</shortdesc>

    <description xml:lang="en">libstrophe is a lightweight XMPP client library
        written in C. It has minimal dependencies and is configurable for
        various environments. It runs well on Linux, Unix and Windows based
        platforms.</description>
    <description xml:lang="fr">libstrophe est une bibliothèque légère écrite en
        C pour les clients XMPP. Elle a un minimum de dépendances et est
        configurable pour des environnements variés. Elle tourne bien sur les
        plateformes basées sur Linux, Unix et Windows.</description>

    <homepage rdf:resource="https://strophe.im/libstrophe/" />
    <download-page rdf:resource="https://github.com/strophe/libstrophe/releases" />
    <schema:documentation rdf:resource="https://strophe.im/libstrophe/doc/0.13.0" />
    <bug-database rdf:resource="https://github.com/strophe/libstrophe/issues" />
    <developer-forum rdf:resource="https://groups.google.com/g/libstrophe" />
    <support-forum rdf:resource="https://groups.google.com/g/libstrophe" />

    <license
      rdf:resource="https://github.com/strophe/libstrophe/blob/master/COPYING" />

    <language>en</language>

    <programming-language>C</programming-language>

    <os>Linux</os>

    <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-library" />

    <implements rdf:resource='https://xmpp.org/rfcs/rfc6120.html' />
    <implements rdf:resource='https://xmpp.org/rfcs/rfc6121.html' />

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0077.html' />
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.4</xmpp:version>
        <xmpp:since>0.10.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0114.html' />
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.6</xmpp:version>
        <xmpp:since>0.8.8</xmpp:since>
      </xmpp:SupportedXep>
    </implements>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0138.html' />
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.1</xmpp:version>
        <xmpp:since>0.13.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0178.html' />
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.2</xmpp:version>
        <xmpp:since>0.11.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource='https://xmpp.org/extensions/xep-0198.html' />
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.6.3</xmpp:version>
        <xmpp:since>0.11.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>

    <release>
      <Version>
        <revision>0.14.0</revision>
        <created>2025-03-13</created>
        <file-release
          rdf:resource="https://github.com/strophe/libstrophe/releases/download/0.14.0/libstrophe-0.14.0.tar.gz" />
      </Version>
    </release>
  </Project>
</rdf:RDF>